# Build context is the repo root (see server/Dockerfile), so everything the
# server image does not need is excluded here — the frontend node_modules and
# the CLI's scanner binaries alone are ~1GB.
.git
.github

# Frontend workspaces — the API serves no assets.
app/
web/

# Build output and local scan state.
bin/
dist/
*.exe
*.out
*.test
coverage.out
*.prof
.pindrop/

# Local config and secrets.
**/.env
**/.env.local
*.db

# The CLI module: server/ is a separate, self-contained module.
cmd/
internal/
testdata/
img/
Formula/
docs/
go.work
go.work.sum
