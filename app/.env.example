# Supabase project URL (Dashboard → Project Settings → API → Project URL).
# Use the base URL only — do NOT append /rest/v1 or any other path.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Dashboard → Project Settings → API → anon public).
VITE_SUPABASE_ANON_KEY=your-anon-key

# Origin of the product API. Leave unset in development — Vite proxies /api to
# http://127.0.0.1:8080. Set it on a deployed frontend (e.g. https://api.example.com).
VITE_API_BASE_URL=
