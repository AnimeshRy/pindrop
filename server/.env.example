# Supabase project URL (Dashboard → Project Settings → API → Project URL).
# Base URL only — do NOT append /rest/v1 or any other path.
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co

# Postgres connection string.
#
# Production (Supabase): Dashboard → Project Settings → Database → connection string.
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
#
# Local Docker (see server/README.md — create pindrop/pindrop_dev first):
DATABASE_URL=postgresql://pindrop:pindrop_local_dev@localhost:54320/pindrop_dev?sslmode=disable

# Listen port (optional).
PORT=8080

# Browser origin allowed to call this API (optional).
CORS_ORIGIN=http://localhost:5174
