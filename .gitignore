# Build artifacts
/bin/
/dist/
*.exe
*.out
*.test

# Coverage and profiling
coverage.out
*.prof

# Scan output
/.pindrop/

# Frontend
/web/node_modules/
# dist is generated, but .gitkeep must stay committed: `//go:embed all:dist`
# fails to compile when the directory is absent, so a fresh clone needs it.
/web/dist/*
!/web/dist/.gitkeep
# Generated by @tanstack/router-plugin on every build.
/web/src/routeTree.gen.ts

# Local environment
.env
.env.local
!/testdata/**/.env.example

# IDE and OS noise
.DS_Store
.idea/
# .vscode/settings.json is shared: it carries the GOROOT workaround and the
# nested-pnpm tooling paths. Personal VS Code files stay ignored.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Employer-internal reference material. Never commit.
spectator.md
