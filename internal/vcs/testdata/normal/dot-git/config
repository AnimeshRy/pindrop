[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
# a comment line
[remote "origin"]
	url = https://github.com/owner/repo.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[remote "upstream"]
	url = https://github.com/other/repo.git
[branch "main"]
	remote = origin
	merge = refs/heads/main
